# YouTube Licence Checker settings
# ---------------------------------
# This file is only for nonsecret workflow settings. Configure the YouTube API
# key in the launcher's protected settings or set YOUTUBE_API_KEY in the process
# environment; never write the key into this file.

# Normal folders. Most users should not change these.
INPUT_FOLDER=input
OUTPUT_FOLDER=output
LOG_FOLDER=logs
ARCHIVE_FOLDER=archive

# Use the editable licence-term dictionary.
TERMS_JSON=license_terms_dictionary.json

# Recommended defaults.
RUN_BLIND_VERIFICATION_AFTER_AUDIT=true
INSERT_HEADER_FOR_HEADERLESS_TABLES=true
ONLY_HEADERED_TABLES=false
SCAN_TAGS=false
